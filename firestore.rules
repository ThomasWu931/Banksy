rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // One shared wallet, no login. Anyone with the site can read and change it.
    match /wallet/global {
      allow read: if true;
      allow create, update: if request.resource.data.balance is number
                            && request.resource.data.balance >= 0;
    }
  }
}
